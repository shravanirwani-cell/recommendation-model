# Copy this file to `.env` and fill in what you have. EVERYTHING is optional
# — the service runs in full demo mode (mock Google Places + rule-based
# intent extraction + offline TF-IDF embeddings) with this file untouched.

# --- Optional external APIs ---
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
# --- Mumbai dataset source: "json" (default, zero setup) or "mysql" ---
MUMBAI_DATA_SOURCE=json
# MUMBAI_DATA_PATH=./data/mumbai_places.json

# --- MySQL (only read if MUMBAI_DATA_SOURCE=mysql or FEEDBACK_STORE=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=travelsathi
MYSQL_PASSWORD=
MYSQL_DATABASE=travelsathi

# --- Feedback storage: "json" (default) or "mysql" ---
FEEDBACK_STORE=json

# --- Embeddings: "auto" (default), "st" (force sentence-transformers), "hashing" (force offline fallback) ---
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Google Places tuning ---
GOOGLE_PLACES_CANDIDATE_LIMIT=60
GOOGLE_PLACES_DEFAULT_RADIUS_M=3000

# --- Ranking weights (Section 15 — must sum to ~1.0; see DESIGN.md) ---
WEIGHT_SEMANTIC=0.40
WEIGHT_DISTANCE=0.20
WEIGHT_BUDGET=0.15
WEIGHT_TIME=0.10
WEIGHT_GROUP=0.05
WEIGHT_QUALITY=0.05
WEIGHT_LOCAL=0.05

DEFAULT_TOP_K=10
MAX_TOP_K=50
LOG_LEVEL=INFO
